{% extends "_base.njk" %}
{% from "_macros.njk" import identity, photo, entry %}
{% set p = cv.person %}

{% block head %}
<meta name="description" content="{{ p.title }}, {{ cv.affiliations[p.org].name }}. {{ cv.about.lead }}">
<link rel="canonical" href="{{ p.url }}">
<link rel="icon" href="{{ root }}favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="{{ root }}apple-touch-icon.png">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ p.name }}, {{ p.honorific }}">
<meta property="og:description" content="{{ p.title }}, {{ cv.affiliations[p.org].name }}">
<meta property="og:url" content="{{ p.url }}">
<meta property="og:image" content="{{ p.url }}photos/hero-824.webp">
{% endblock %}

{% block body %}
<div class="page">

<div class="side">
<header class="hero">
  {{ photo('hero', root, '(min-width: 960px) 44vw, (min-width: 440px) 440px, 100vw', true) }}
  <div class="hero-in">
    <div class="top">
      <img class="seal" src="{{ root }}seal.webp" width="22" height="48" alt="">
      {% if languages.length > 1 %}
      <nav class="lang" aria-label="Language">
        {% for l in languages %}<a href="{{ root }}{{ l.path }}" lang="{{ l.code }}"{% if l.code == lang %} aria-current="page"{% endif %}>{{ l.label }}</a>{% endfor %}
      </nav>
      {% endif %}
    </div>
    {{ identity(cv) }}
  </div>
</header>

<nav class="actions" aria-label="Contact">
  <a class="btn btn-primary" href="{{ root }}mervin-zhao.vcf" download>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/></svg>Save contact</a>
  <a class="btn" href="mailto:{{ p.email.work }}">Email</a>
  <a class="btn" href="{{ p.links.linkedin }}">LinkedIn</a>
</nav>
</div>

<main>
<section class="about" aria-labelledby="h-about">
  <div class="h2"><h2 id="h-about">About</h2></div>
  <p class="lead">{{ cv.about.lead }}</p>
  <p class="body">{{ cv.about.body }}</p>
  <ul class="chips">{% for f in cv.about.focus %}<li>{{ f }}</li>{% endfor %}</ul>
</section>

<section aria-labelledby="h-exp">
  <div class="h2"><h2 id="h-exp">Experience</h2></div>
  <ul>
    {% for e in cv.experience %}{{ entry(cv, e, e.role, accent=(loop.first and not e.end and theme['brand-accent-logo'])) }}{% endfor %}
  </ul>
</section>

<section aria-labelledby="h-edu">
  <div class="h2"><h2 id="h-edu">Education</h2></div>
  <ul>
    {% for e in cv.education %}{{ entry(cv, e, e.degree) }}{% endfor %}
  </ul>
</section>

<section aria-labelledby="h-pubs">
  <div class="h2"><h2 id="h-pubs">Selected publications</h2></div>
  <ul>
    {% for pub in cv.publications %}{% if pub.selected %}
    <li class="pub">
      <span class="pub-title">{{ pub.title }}</span>
      <span class="pub-meta">{{ authorsShort(pub.authors) }} <em>{{ pub.venue }}</em> ({{ pub.year }})</span>
    </li>
    {% endif %}{% endfor %}
  </ul>
  <div class="pubs-foot">
    <span>{{ cv.publications.length }} publications, {{ cv.patents.length }} patents</span>
    <a href="{{ p.links.scholar }}">Google Scholar</a>
  </div>
</section>
</main>

<footer>
  {% if hasCvPdf %}
  <a class="btn" href="{{ root }}cv.pdf">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4"/><path d="M9 13h6"/><path d="M9 17h6"/></svg>Download CV (PDF)</a>
  {% endif %}
  <div class="contact">
    <span class="label">Contact</span>
    {% for kind in ['work', 'home'] %}{% if p.email[kind] %}<a href="mailto:{{ p.email[kind] }}">{{ p.email[kind] }}</a>{% endif %}{% endfor %}
  </div>
  <span class="copy">© {{ buildYear }} {{ p.name }}</span>
</footer>

</div>
{% endblock %}
